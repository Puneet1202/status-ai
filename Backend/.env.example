ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

RESEND_API_KEY=
VITE_EXCHANGE_RATE_API_KEY=
GEMINI_API_KEY =

# 🧠 "Brain" — reliable intent understanding (any phrasing, no regex).
# PROVIDER: which model company runs the brain. Switching = change this line only.
#   anthropic (default) | openai | gemini
AI_PROVIDER=anthropic
# Key for the chosen provider (only the selected one is used):
ANTHROPIC_API_KEY=          # console.anthropic.com  (Haiku — best tool-calling)
OPENAI_API_KEY=             # platform.openai.com    (gpt-4o-mini — ~7x cheaper)
GEMINI_API_KEY=             # aistudio.google.com     (gemini-2.0-flash — ~10x cheaper)
# Optional: override the model id. Empty → provider's sensible default.
#   anthropic→claude-haiku-4-5  openai→gpt-4o-mini  gemini→gemini-2.0-flash
AI_MODEL=
# Optional kill-switch: set to "off" to force deterministic mode even with a key set.
AI_BRAIN=
# Token guard: max AI messages per minute per employee (default 20). Lower it to
# stop a chatty user from burning credit; raise it for heavy teams.
AI_RATE_PER_MIN=20

# 🚩 Report alerts — get pinged when a user reports a wrong AI reply (with the
# transcript), instead of watching the DB. Paste a Slack OR Discord webhook URL.
#   Slack:   api → Incoming Webhooks → create → copy URL.
#   Discord: channel → Edit → Integrations → Webhooks → New → copy URL.
# Empty = reports still save to the ai_feedback table, just no ping.
REPORT_WEBHOOK_URL=
