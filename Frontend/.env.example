# Copy to .env (or .env.local) and set per environment.
# Base URL of the backend API. Leave unset for local dev (defaults to the
# local wrangler dev server at http://localhost:8787).
# In production, point this at your deployed Worker, e.g.:
# VITE_API_URL=https://keyss-timesheet-backend.<your-subdomain>.workers.dev
VITE_API_URL=
